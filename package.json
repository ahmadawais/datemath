{
  "name": "datemath-cli",
  "version": "1.5.0",
  "description": "A beautiful CLI for date calculations in natural language",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "datemath": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch --onSuccess 'node dist/index.js'",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "cli",
    "date",
    "math",
    "calculator",
    "time"
  ],
  "author": "Ahmad Awais <me@ahmadawais.com> (https://ahmadawais.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadawais/datemath-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ahmadawais/datemath-cli/issues"
  },
  "homepage": "https://github.com/ahmadawais/datemath-cli#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "gradient-string": "^2.0.2",
    "ora": "^8.0.1"
  }
}
